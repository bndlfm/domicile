{
  "action": {
    "default_popup": "popup.html",
    "default_title": "Domicile open popup guard"
  },
  "background": {
    "service_worker": "background.js"
  },
  "description": "An action that opens its popup with action.openPopup(), or its side panel with sidePanel.open(), from action.onClicked, as Phantom does, for guard-extension-open-popup.sh and guard-extension-side-panel.sh.",
  "key": "",
  "manifest_version": 3,
  "name": "Domicile open popup guard",
  "permissions": ["sidePanel", "tabs"],
  "side_panel": {
    "default_path": "panel.html"
  },
  "version": "1"
}
