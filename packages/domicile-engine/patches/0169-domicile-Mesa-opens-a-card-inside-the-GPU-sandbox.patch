From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: domicile CI <ci@domicile.invalid>
Date: Thu, 5 Nov 2026 00:00:00 +0000
Subject: [PATCH] domicile: Mesa opens a card inside the GPU sandbox

On a tty the browser hands every card to the GPU process after its
sandbox is up, so gbm_create_device runs inside it. Desktop Linux's
broker allows only /dev/dri/card*, /etc/drirc and /dev/shm, and refuses
the rest with EACCES. On a VMware card with 3D on, Mesa's GBM failed
("no GBM for card0 (vmwgfx) ...: EACCES") while GNOME used the card, and
the desktop drew on the CPU.

AddDomicileMesaGpuPermissions lets through, read-only, what Mesa reads
for a card, as ChromeOS's AMD policy does:

- the directory libgbm came from (its `gbm/` backend, `dri/` drivers
  and the libraries they link), /run/opengl-driver/lib on NixOS, and
  GBM_BACKENDS_PATH and LIBGL_DRIVERS_PATH
- /etc/ld.so.cache and /usr/share/drirc.d
- /sys/dev/char and /sys/devices, and readlink, for libdrm's
  drmGetDevice2

and the render nodes read-write.

Verified: not built. This repository cannot build Chromium; the engine
job builds it on `crux`.
---
 content/common/gpu_pre_sandbox_hook_linux.cc | 64 ++++++++++++++++++++
 1 file changed, 64 insertions(+)

diff --git a/content/common/gpu_pre_sandbox_hook_linux.cc b/content/common/gpu_pre_sandbox_hook_linux.cc
index 2e53794..44ce77d 100644
--- a/content/common/gpu_pre_sandbox_hook_linux.cc
+++ b/content/common/gpu_pre_sandbox_hook_linux.cc
@@ -451,6 +451,64 @@ void AddVulkanICDPermissions(std::vector<BrokerFilePermission>* permissions) {
   }
 }
 
+// DOMICILE: what Mesa opens for a card the browser hands the GPU process
+// after the sandbox is up: on a tty every card arrives that way, so GBM on
+// it (gbm_create_device) runs inside the sandbox. Without these, Mesa's
+// GBM backend (`gbm/dri_gbm.so` since Mesa 25), the libraries it links, the
+// card's render node and its sysfs entry are refused with EACCES, and the
+// card shows only software output. Read-only, except the render nodes.
+void AddDomicileMesaGpuPermissions(
+    std::vector<BrokerFilePermission>* permissions) {
+  permissions->push_back(BrokerFilePermission::ReadOnly("/etc/ld.so.cache"));
+  permissions->push_back(
+      BrokerFilePermission::ReadOnlyRecursive("/usr/share/drirc.d/"));
+
+  // The directory libgbm came from holds `gbm/`, `dri/` and the libraries
+  // they link on Debian, Fedora and Arch. NixOS puts the drivers under
+  // /run/opengl-driver. GBM_BACKENDS_PATH and LIBGL_DRIVERS_PATH move them.
+  std::vector<std::string> library_dirs = {"/run/opengl-driver/lib/"};
+  void* gbm = dlopen("libgbm.so.1", RTLD_NOW);
+  Dl_info info;
+  if (gbm && dladdr(dlsym(gbm, "gbm_create_device"), &info)) {
+    library_dirs.push_back(base::FilePath(info.dli_fname)
+                               .DirName()
+                               .AsEndingWithSeparator()
+                               .value());
+  } else {
+    LOG(ERROR) << "domicile: no libgbm to find Mesa's drivers by; GBM may "
+                  "be refused in the GPU sandbox";
+  }
+  for (const char* variable : {"GBM_BACKENDS_PATH", "LIBGL_DRIVERS_PATH"}) {
+    const char* value = getenv(variable);
+    if (!value) {
+      continue;
+    }
+    std::stringstream paths(value);
+    std::string path;
+    while (std::getline(paths, path, ':')) {
+      if (!path.empty()) {
+        library_dirs.push_back(
+            base::FilePath(path).AsEndingWithSeparator().value());
+      }
+    }
+  }
+  for (const std::string& dir : library_dirs) {
+    permissions->push_back(BrokerFilePermission::ReadOnlyRecursive(dir));
+  }
+
+  // libdrm's drmGetDevice2 reads the card's sysfs entry to name its driver.
+  for (const char* item : {"/sys/dev/char", "/sys/devices"}) {
+    std::string path(item);
+    permissions->push_back(
+        BrokerFilePermission::StatOnlyWithIntermediateDirs(path));
+    permissions->push_back(BrokerFilePermission::ReadOnly(path));
+    permissions->push_back(BrokerFilePermission::ReadOnlyRecursive(path + "/"));
+  }
+
+  // Render nodes, and each card's /sys/dev/char entry.
+  AddDrmGpuPermissions(permissions);
+}
+
 void AddStandardGpuPermissions(std::vector<BrokerFilePermission>* permissions) {
   static const char kDriCardBasePath[] = "/dev/dri/card";
   static const char kNvidiaCtlPath[] = "/dev/nvidiactl";
@@ -616,6 +674,11 @@ sandbox::syscall_broker::BrokerCommandSet CommandSetForGPU(
        options.use_virtio_specific_policies || IsArchitectureArm())) {
     command_set.set(sandbox::syscall_broker::COMMAND_READLINK);
   }
+  // DOMICILE: libdrm reads the links under a card's /sys/dev/char entry.
+  // See AddDomicileMesaGpuPermissions.
+  if (!IsChromeOS()) {
+    command_set.set(sandbox::syscall_broker::COMMAND_READLINK);
+  }
   return command_set;
 }
 
@@ -669,6 +732,7 @@ std::vector<BrokerFilePermission> FilePermissionsForGpu(
   }
 
   AddStandardGpuPermissions(&permissions);
+  AddDomicileMesaGpuPermissions(&permissions);
   return permissions;
 }
 
